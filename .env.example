ENVIRONMENT=development

# postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://cardioai:cardioai@localhost:5432/cardioai

# generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# email verification (OTP)
# separate secret from JWT_SECRET_KEY on purpose — a leak of one shouldn't compromise the other.
# generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
OTP_HMAC_SECRET=change-me
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_DAY=10
UNVERIFIED_ACCOUNT_GRACE_HOURS=24

# SMTP used to deliver OTP emails. This is separate from any SMTP config the
# frontend (cardio-ai) uses for its own lead-capture emails — no shared state.
# Left blank, the app still boots; OTP sends are skipped (a warning is logged)
# and in ENVIRONMENT=development the code is logged instead, so local testing
# works without real SMTP creds.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@cardioai.app
SMTP_FROM_NAME=CardioAI

# comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://cardioai.health
