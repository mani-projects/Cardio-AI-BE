ENVIRONMENT=development

# postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://cardioai:cardioai@localhost:5432/cardioai

# generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# email verification (OTP)
# separate secret from JWT_SECRET_KEY on purpose — a leak of one shouldn't compromise the other.
# generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
OTP_HMAC_SECRET=change-me
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_DAY=10
UNVERIFIED_ACCOUNT_GRACE_HOURS=24

# password reset
# separate secret from JWT_SECRET_KEY/OTP_HMAC_SECRET on purpose — a leak of
# one shouldn't compromise the others.
# generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
RESET_TOKEN_HMAC_SECRET=change-me
RESET_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_RESEND_COOLDOWN_SECONDS=60
RESET_TOKEN_MAX_SENDS_PER_DAY=10

# account claiming — issued when a paid course registration has no matching
# CardioAI account yet, emailed/shown as a "create your password" link.
# separate secret from the others on purpose — a leak of one shouldn't compromise the rest.
# generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
CLAIM_TOKEN_HMAC_SECRET=change-me
# 7 days — much longer than a password reset, since this is emailed to someone
# who may have paid weeks ago rather than someone actively resetting a password.
CLAIM_TOKEN_EXPIRE_MINUTES=10080

# shared secret the frontend (cardio-ai) presents on the internal
# registrations write endpoints — no logged-in user exists yet at that point
# (checkout is anonymous), so JWT auth doesn't apply. Same idea as the Google
# Sheets Apps Script's ADMIN_SECRET.
# generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
INTERNAL_API_KEY=change-me

# Second factor an admin types into the "Login as" confirmation dialog before
# the impersonation endpoint issues tokens for another user's account. Never
# stored in the frontend — generate with the same command as above.
LOGIN_SECRET_KEY=change-me

# base URL of the frontend (cardio-ai) — used to build the password-reset
# link sent by email, e.g. {FRONTEND_URL}/reset-password?token=...
FRONTEND_URL=http://localhost:3000

# SMTP used to deliver OTP emails. This is separate from any SMTP config the
# frontend (cardio-ai) uses for its own lead-capture emails — no shared state.
# Left blank, the app still boots; OTP sends are skipped (a warning is logged)
# and in ENVIRONMENT=development the code is logged instead, so local testing
# works without real SMTP creds.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@cardioai.app
SMTP_FROM_NAME=CardioAI

# comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://cardioai.health

# object storage for faculty-uploaded PDFs/videos/certificates. The bucket is
# private — every read goes through a freshly-minted presigned GET URL, so no
# ACL/public-access configuration is needed on the bucket itself.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
